{
  "name": "juegos-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install-all": "npm --prefix server install && npm --prefix client install",
    "server": "npm --prefix server start",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n API,CLIENT -c blue,green \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "start": "npm run server",
    "abrir": "bash ./arcade",
    "cerrar": "bash ./arcade --cerrar",
    "dale": "bash ./bin/dale",
    "duro": "bash ./bin/dale --duro",
    "tumba": "bash ./bin/dale --tumba",
    "salud": "bash ./bin/dale --salud"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
