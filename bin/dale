#!/usr/bin/env bash
#
#  🔥 DALE — el encendido oficial de ArcadePaLoMuchacho.
#
#  Uso:
#    dale              → modo desarrollo + abre el navegador + URL para tu teléfono
#    dale --duro       → modo producción (compila y sirve todo junto)
#    dale --tumba      → apaga todo
#    dale --salud      → chequeo: ¿lista para Google y para instalar en PC/móvil?
#    dale --ayuda      → esta ayuda
#
set -u

FUENTE="${BASH_SOURCE[0]}"
while [ -L "$FUENTE" ]; do
  DIR_FUENTE="$(cd "$(dirname "$FUENTE")" && pwd)"
  FUENTE="$(readlink "$FUENTE")"
  [[ "$FUENTE" != /* ]] && FUENTE="$DIR_FUENTE/$FUENTE"
done
DIR="$(cd "$(dirname "$FUENTE")/.." && pwd)"
# Mismos archivos que el script clásico ./arcade: ambos comandos interoperan.
PIDFILE="/tmp/arcade-web.pids"
LOG="/tmp/arcade-web.log"
PUERTO_API=3001
PUERTO_WEB=5173

ROJO='\033[0;31m'; VERDE='\033[0;32m'; AMARILLO='\033[1;33m'
CIAN='\033[0;36m'; MAGENTA='\033[0;35m'; BLANCO='\033[1;37m'; RESET='\033[0m'

banner() {
  echo -e "${ROJO}  ██████╗  █████╗ ${AMARILLO}██╗      ██████╗ ${VERDE}███╗   ███╗██╗   ██╗ ██████╗██╗  ██╗ █████╗  ██████╗██╗  ██╗ ██████╗ ${RESET}"
  echo -e "${ROJO}  ██╔══██╗██╔══██╗${AMARILLO}██║     ██╔═══██╗${VERDE}████╗ ████║██║   ██║██╔════╝██║  ██║██╔══██╗██╔════╝██║  ██║██╔═══██╗${RESET}"
  echo -e "${ROJO}  ██║  ██║███████║${AMARILLO}██║     ██║   ██║${VERDE}██╔████╔██║██║   ██║██║     ███████║███████║██║     ███████║██║   ██║${RESET}"
  echo -e "${ROJO}  ██║  ██║██╔══██║${AMARILLO}██║     ██║   ██║${VERDE}██║╚██╔╝██║██║   ██║██║     ██╔══██║██╔══██║██║     ██╔══██║██║   ██║${RESET}"
  echo -e "${ROJO}  ██████╔╝██║  ██║${AMARILLO}███████╗╚██████╔╝${VERDE}██║ ╚═╝ ██║╚██████╔╝╚██████╗██║  ██║██║  ██║╚██████╗██║  ██║╚██████╔╝${RESET}"
  echo -e "${CIAN}  ╚═════╝ ╚═╝  ╚═╝${AMARILLO}╚══════╝ ╚═════╝ ${VERDE}╚═╝     ╚═╝ ╚═════╝  ╚═════╝╚═╝  ╚═╝╚═╝  ╚═╝ ╚═════╝╚═╝  ╚═╝ ╚═════╝ ${RESET}"
  echo -e "${MAGENTA}                    🔥 232 minijuegos · XP · logros · instalable 🔥${RESET}"
  echo ""
}

ip_lan() {
  hostname -I 2>/dev/null | awk '{print $1}'
}

abrir_navegador() {
  local url="$1"
  if command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1 &
  elif command -v wslview >/dev/null 2>&1; then wslview "$url" >/dev/null 2>&1 &
  elif command -v open >/dev/null 2>&1; then open "$url" >/dev/null 2>&1 & fi
  echo -e "  👉 PC: ${BLANCO}$url${RESET}"
  local ip; ip="$(ip_lan)"
  if [ -n "$ip" ]; then
    echo -e "  📱 Móvil (mismo WiFi): ${BLANCO}http://$ip:$2${RESET}"
  fi
}

vivo() { curl -sf -m1 "http://localhost:$1${2:-/}" >/dev/null 2>&1; }

esperar() {
  for _ in $(seq 1 30); do vivo "$1" "${3:-/}" && return 0; sleep 1; done
  echo -e "${AMARILLO}⚠️  $2 no respondió en :$1. Mira: tail -50 $LOG${RESET}"
  return 1
}

lanzar() {
  echo -e "${CIAN}🚀 Prendiendo $1...${RESET}"
  # shellcheck disable=SC2086
  nohup $2 >>"$LOG" 2>&1 &
  echo $! >>"$PIDFILE"
}

tumbar() {
  if [ ! -f "$PIDFILE" ]; then echo -e "${CIAN}ℹ️  Nada prendido, todo apagado ya. 😴${RESET}"; return 0; fi
  while read -r pid; do kill "$pid" 2>/dev/null; done <"$PIDFILE"
  rm -f "$PIDFILE"; sleep 1
  if command -v fuser >/dev/null 2>&1; then
    fuser -k "$PUERTO_API/tcp" >/dev/null 2>&1; fuser -k "$PUERTO_WEB/tcp" >/dev/null 2>&1
  else
    pkill -f "juegos-web/(server|client)" 2>/dev/null
  fi
  echo -e "${ROJO}🛑 Tumbado. Nos vemos en la próxima jugada. ✌️${RESET}"
}

modo_dev() {
  banner
  : >"$LOG"; : >"$PIDFILE"
  vivo "$PUERTO_API" "/api/stats" || (cd "$DIR" && lanzar "la API :$PUERTO_API" "npm run server")
  vivo "$PUERTO_WEB" || (cd "$DIR" && lanzar "la web :$PUERTO_WEB" "npm run client")
  esperar "$PUERTO_WEB" "La web" || esperar "$PUERTO_API" "La API" "/api/stats" || true
  echo ""
  echo -e "${VERDE}✅ DALE, está prendido:${RESET}"
  abrir_navegador "http://localhost:$PUERTO_WEB" "$PUERTO_WEB"
  echo -e "  🔌 API: http://localhost:$PUERTO_API/api/stats"
  echo -e "  🛑 Apagar: ${BLANCO}dale --tumba${RESET}"
}

modo_duro() {
  banner
  echo -e "${AMARILLO}📦 Compilando en modo DURO...${RESET}"
  (cd "$DIR" && npm run build) || { echo -e "${ROJO}❌ Falló la compilación.${RESET}"; exit 1; }
  : >"$LOG"; : >"$PIDFILE"
  vivo "$PUERTO_API" "/api/stats" || (cd "$DIR" && lanzar "el servidor PRO :$PUERTO_API" "npm start")
  esperar "$PUERTO_API" "El servidor" "/api/stats" || true
  echo ""
  echo -e "${VERDE}✅ DALE DURO, todo junto en producción:${RESET}"
  abrir_navegador "http://localhost:$PUERTO_API" "$PUERTO_API"
  echo -e "  🛑 Apagar: ${BLANCO}dale --tumba${RESET}"
}

ok() { echo -e "${VERDE}  ✅ $1${RESET}"; }
no() { echo -e "${ROJO}  ❌ $1${RESET}"; }

salud() {
  banner
  echo -e "${BLANCO}🩺 Chequeo PaLoMuchacho — Google + instalación:${RESET}"
  echo ""
  echo -e "${BLANCO}[ Instalable en PC y móvil ]${RESET}"
  local M="client/public/site.webmanifest"
  grep -q '"name": "ArcadePaLoMuchacho' "$DIR/$M" 2>/dev/null && ok "Manifest con marca única" || no "Manifest sin marca"
  grep -q '"start_url": "./"' "$DIR/$M" 2>/dev/null && ok "start_url portable (./)" || no "start_url no portable"
  for i in favicon.svg icon-192.png icon-512.png maskable-512.png apple-touch-icon.png; do
    [ -f "$DIR/client/public/$i" ] && ok "Icono $i" || no "Falta icono $i"
  done
  grep -q 'aplm-v' "$DIR/client/public/sw.js" 2>/dev/null && ok "Service worker propio (offline)" || no "Sin service worker"
  grep -q 'shortcuts' "$DIR/$M" 2>/dev/null && ok "Accesos directos PWA (3)" || no "Sin shortcuts"
  grep -q 'BASE_URL}sw.js' "$DIR/client/src/main.jsx" 2>/dev/null && ok "SW se registra en raíz y subruta" || no "Registro SW fijo a /"
  grep -q 'lazy(() => import' "$DIR/client/src/games/GAMES.js" 2>/dev/null && ok "232 juegos con carga perezosa" || no "Sin code-splitting"
  echo ""
  echo -e "${BLANCO}[ Buscable en Google ]${RESET}"
  grep -q '<link rel="canonical"' "$DIR/client/index.html" 2>/dev/null && ok "Canonical presente" || no "Sin canonical"
  grep -q 'og:site_name.*ArcadePaLoMuchacho' "$DIR/client/index.html" 2>/dev/null && ok "Open Graph con marca" || no "Sin Open Graph"
  local n; n=$(grep -o '"@type":"VideoGame"' "$DIR/client/index.html" 2>/dev/null | wc -l)
  [ "$n" -ge 232 ] && ok "JSON-LD con $n juegos" || no "JSON-LD incompleto ($n)"
  local u; u=$(grep -c '<loc>' "$DIR/client/public/sitemap.xml" 2>/dev/null)
  [ "$u" -ge 79 ] && ok "Sitemap con $u URLs absolutas" || no "Sitemap incompleto ($u)"
  grep -q 'helmet' "$DIR/server/index.js" 2>/dev/null && ok "Servidor endurecido (helmet + rate-limit)" || no "Servidor sin endurecer"
  [ -f "$DIR/vercel.json" ] && ok "Config Vercel lista" || no "Sin vercel.json"
  [ -f "$DIR/.github/workflows/deploy-pages.yml" ] && ok "Deploy GitHub Pages listo" || no "Sin workflow Pages"
  echo ""
  echo -e "${AMARILLO}📌 Para salir OFICIALMENTE en Google falta:${RESET}"
  echo "   1. git push origin main + git push hf main"
  echo "   2. Desplegar en Vercel (https público)"
  echo "   3. En Google Search Console: añadir la URL e indexar el sitemap"
  echo "   4. Esperar días/semanas a que Google rastree (la marca es única: rankeará #1)"
  echo ""
  echo -e "${AMARILLO}📌 Para instalar en el teléfono a pleno (con icono y offline):${RESET}"
  echo "   Usa la URL https desplegada, no la de pruebas local."
}

case "${1:-}" in
  --ayuda|-h|help) sed -n '2,12p' "$0" ;;
  --tumba|tumba|stop|off) banner; tumbar ;;
  --duro|duro|prod) modo_duro ;;
  --salud|salud|doctor) salud ;;
  ""|--dev|dev) modo_dev ;;
  *) echo -e "${ROJO}❌ Esa no me la sé: $1${RESET}"; sed -n '2,12p' "$0"; exit 1 ;;
esac
